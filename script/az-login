#!/usr/bin/env bash
# script/az-login signs in to the Azure subscription used by the Azure MCP
# server and the "azure" tool in Copilot. It sets AZURE_CONFIG_DIR to the
# repo-local .azure/ directory so the Azure CLI's token cache and profile
# stay out of the user's global ~/.azure and out of git (only .azure/config
# is tracked; see .gitignore).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly SCRIPT_DIR

# shellcheck source=script/lib/azure-session.bash
. "${SCRIPT_DIR}/lib/azure-session.bash"

usage() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS]

Sign in to the Azure subscription used by the Azure MCP server. Reuses an
existing session if one is already valid for the subscription.

OPTIONS:
  -h, --help                  Show this help message
  -f, --force                 Force a fresh interactive sign-in

ENVIRONMENT:
  AZ_SUBSCRIPTION_ID          Subscription ID. The environment overrides .env,
                               which overrides defaults.subscription in
                               .azure/config.

EOF
}

do_login() {
  log_info "Signing in to Azure"
  az login --output none
}

select_subscription() {
  log_info "Selecting subscription ${AZ_SUBSCRIPTION_ID}"
  az account set --subscription "${AZ_SUBSCRIPTION_ID}"
}

show_active() {
  log_info "Signed in to the Azure subscription:"
  az account show \
    --subscription "${AZ_SUBSCRIPTION_ID}" \
    --query "{name:name, subscriptionId:id, tenantId:tenantId, user:user.name}" \
    --output table
}

main() {
  local force=false

  while getopts "hf-:" opt; do
    case $opt in
      h) usage; exit 0 ;;
      f) force=true ;;
      -) case $OPTARG in
           help) usage; exit 0 ;;
           force) force=true ;;
           *) echo "Unknown option: --$OPTARG" >&2; usage >&2; exit 1 ;;
         esac ;;
      *) echo "Invalid option: -${OPTARG:-}" >&2; usage >&2; exit 1 ;;
    esac
  done

  resolve_subscription

  require_az

  use_repo_azure_config

  if [[ "${force}" == "true" ]]; then
    do_login
  elif have_valid_session; then
    log_info "Existing Azure session found; reusing it."
  else
    do_login
  fi

  select_subscription
  show_active

  log_info "Azure sign-in complete."
}

main "$@"
