#!/usr/bin/env bash

set -euo pipefail

if [[ "$(uname)" != "Darwin" ]]; then
  echo "This script is for macOS only."
  exit 0
fi

PROJECT_DIR="$(git rev-parse --show-toplevel)"
readonly PROJECT_DIR

# Each entry is "command|purpose|install hint". Required dependencies are the
# user's responsibility to provide; this script only verifies and reports.
REQUIRED_DEPS=(
  "go|Go toolchain used to build sudhaus-engen and install its lint tools|brew install go"
  "git|Repository root discovery used by every script in script/|xcode-select --install"
  "make|Entry point for the build, lint, test, and review targets|xcode-select --install"
  "curl|Downloads external assets when needed|brew install curl"
  "az|Azure CLI used by the Terraform and provider scripts|brew install azure-cli"
  "terraform|Provisions the Azure infrastructure under terraform/|brew install terraform"
  "shellcheck|Shell linting run by make lint and make review|brew install shellcheck"
  "gh|GitHub CLI used for pull request and issue workflows|brew install gh"
  "jq|JSON processing in helper scripts|brew install jq"
  "shasum|Derives the Terraform state account name in script/tfstate-bootstrap|preinstalled on macOS"
)

usage() {
  cat << EOF
Usage: $0 [OPTIONS]

Bootstrap a sudhaus-engen development workspace on macOS: verify the required
system dependencies are present and install project-local Go tools into bin/.

This script never installs system dependencies. When something is missing it
reports what is required and how to install it; providing them is up to you.

OPTIONS:
  -h, --help     Show this help message
EOF
}

parse_args() {
  while getopts "h-:" opt; do
    case "${opt}" in
      h) usage; exit 0 ;;
      -)
        case "${OPTARG}" in
          help) usage; exit 0 ;;
          *) echo "Unknown option: --${OPTARG}" >&2; usage >&2; exit 2 ;;
        esac
        ;;
      *) usage >&2; exit 2 ;;
    esac
  done
}

report_missing() {
  echo "" >&2
  echo "[ERROR] Missing required dependencies:" >&2
  local entry cmd purpose hint rest
  for entry in "$@"; do
    cmd="${entry%%|*}"
    rest="${entry#*|}"
    purpose="${rest%%|*}"
    hint="${rest#*|}"
    printf '  %-12s %s\n' "${cmd}" "${purpose}" >&2
    printf '  %-12s install with: %s\n' "" "${hint}" >&2
  done
}

check_dependencies() {
  echo "Checking system dependencies..."

  local missing=()
  local entry cmd

  for entry in "${REQUIRED_DEPS[@]}"; do
    cmd="${entry%%|*}"
    if command -v "${cmd}" > /dev/null 2>&1; then
      echo "  ${cmd} ok"
    else
      missing+=("${entry}")
    fi
  done

  if (( ${#missing[@]} > 0 )); then
    report_missing "${missing[@]}"
    echo "" >&2
    echo "Install the dependencies above, then re-run script/bootstrap." >&2
    exit 1
  fi
}

install_tools() {
  "${PROJECT_DIR}/script/install-tools"
}

main() {
  parse_args "$@"

  mkdir -p "${PROJECT_DIR}/tmp"

  check_dependencies
  install_tools
}

main "$@"
